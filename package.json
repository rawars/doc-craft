{
  "name": "doc-craft",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.4.2",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm --filter @doc-craft/markdown test",
